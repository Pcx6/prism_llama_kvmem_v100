# Copy to .env and fill in. .env is gitignored; never commit real keys.
# This file is read by deploy/start-llama.sh only.
# start-llama-14803.sh and quickstart.sh pick ALIAS by 1/2 and do not read .env.
# Load with: set -a; . ./.env; set +a

# GSQ default
MODEL=models/Qwen3.8-27B-GSQ-RCO-IQ3_XXS-mtp.gguf
MMPROJ=models/mmproj-Qwen3.8-27B-BF16.gguf
ALIAS=Qwen3.8-27B-GSQ-RCO-IQ3_XXS
API_KEY=change-me

# Build-only: export in the shell for cmake/quickstart; not read from .env
# KVMEM_ROOT=/path/to/kvmem-root

# optional
# PORT=14803
# CTX=262144
KV_BUDGET=12288
KV_GEN_RESERVE=28672
# KV_TTL=86400
# THREADS=24
# LLAMA_BIN=/path/to/llama-server

# Bonsai legacy (uncomment for generic deploy/start-llama.sh; supported profile is start-llama-14803.sh 2)
# MODEL=models/Ternary-Bonsai-2-27B-PTQ1_0.gguf
# MMPROJ=models/Ternary-Bonsai-2-27B-mmproj-Q8_0.gguf
# ALIAS=Bonsai-2-27B
# KV_BUDGET=12288
# KV_GEN_RESERVE=22528
