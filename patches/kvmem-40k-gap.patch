diff --git a/src/kvmem-root/src/adapter/llama-memory-kvmem.cpp b/src/kvmem-root/src/adapter/llama-memory-kvmem.cpp
index 218ebbb..b9417b9 100644
--- a/src/kvmem-root/src/adapter/llama-memory-kvmem.cpp
+++ b/src/kvmem-root/src/adapter/llama-memory-kvmem.cpp
@@ -5875,8 +5875,19 @@ struct llama_memory_kvmem::NativeBackend final : kvmem::MemoryBackend {
             result.blocks.push_back({b, owner.packed_complete((uint32_t) id, b.valid_tokens) ? b.content_version : 0});
